    <dependencies>
        <dependency>
            <groupId>com.gaozhaoyang</groupId>
            <artifactId>case-orchestrator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
