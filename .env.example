# 复制为 .env 后修改。不要把真实密钥和密码提交到 Git。
APP_AI_MODE=mock
DEEPSEEK_API_KEY=
MYSQL_ROOT_PASSWORD=replace_with_root_password
WORKFLOW_MYSQL_PASSWORD=replace_with_app_password
BGE_MODEL_DIRECTORY=F:/ai-models/bge-small-zh-v1.5
MES_KNOWLEDGE_ENABLED=false
MES_KNOWLEDGE_ROOT=F:/path/to/sanitized-mes-workspace
MES_KNOWLEDGE_MAX_FILES=400
MES_KNOWLEDGE_MAX_FILE_BYTES=131072
KNOWLEDGE_INDEX_ENABLED=true
KNOWLEDGE_INDEX_ROOT=F:/agent-workspaces/knowledge-index
KNOWLEDGE_INDEX_MODEL_ID=bge-small-zh-v1.5-v1
AGENTIC_RAG_MAX_ROUNDS=2
AGENTIC_RAG_MAX_QUERIES=6
AGENTIC_RAG_MAX_EVIDENCE=8
CODING_EXECUTOR_THREADS=2
CODING_EXECUTOR_QUEUE_CAPACITY=20
CODING_MAX_TASK_RUNTIME_MS=300000
